if SHIELD_DACTYL-MANUFORM-5X6_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "Dactyl 5x6"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Without these the right half's battery level never leaves the keyboard - only
# its own LED shows it. Fetching pulls the peripheral's level over the split
# link; the proxy exposes it to the host as a second Battery Service instance.
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif

if SHIELD_DACTYL-MANUFORM-5X6_LEFT || SHIELD_DACTYL-MANUFORM-5X6_RIGHT

config ZMK_SPLIT
    default y

endif